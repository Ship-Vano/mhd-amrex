# Copy this file to scripts/cluster/sites/NAME.env and fill in the site facts.
# The submitter `source`s this file, so every value must be valid shell:
# leave unknown fields as '' rather than as a <placeholder>, which bash
# reads as a redirection and rejects with a syntax error.
# Site files are ignored by Git because account names and filesystem paths are local.
# Do not put passwords or tokens here.

# Commands executed after `module purge`.  Keep this a single shell command.
# Examples:
#   MHD_MODULES='module load gcc/13 openmpi/4.1 cmake/3.27 python/3.11'
#   MHD_MODULES=':'                         # Ubuntu workstation, no modules
MHD_MODULES='module load compiler mpi cmake python'   # заменить именами модулей площадки

# A read-only clone of this repository visible on the compute nodes.  The
# submitter passes it automatically; override only if the submission directory
# is not the source checkout.
# MHD_SOURCE_DIR=/path/to/mhd-amrex

# Clean immutable MHD2D source at 9d0f60e...  The runner clones it into every
# artifact and applies the corrected overlay there; it never modifies this path.
MHD_LEGACY_SOURCE=/path/to/MHD2D

# Durable storage for campaign artifacts, preferably project storage, not $HOME
# and not node-local $TMPDIR.  A unique subdirectory is made for every campaign.
MHD_ARTIFACT_ROOT=/path/to/mhd-artifacts

# Optional node-local build root.  Empty uses SLURM_TMPDIR/TMPDIR.  Contents
# are disposable build products only; raw evidence stays in MHD_ARTIFACT_ROOT.
# MHD_SCRATCH_ROOT=/scratch/$USER

# SLURM CPU allocation.  Counts must not exceed CPU_NODES * CPU_RANKS_PER_NODE.
MHD_CPU_ACCOUNT=''          # обязательно: имя учётной записи
MHD_CPU_PARTITION=''        # обязательно: имя раздела
MHD_CPU_NODES=1
MHD_CPU_RANKS_PER_NODE=8
# The supplied MPI strong/weak jobs are pure MPI and require 1.  OpenMP is
# measured separately below with exactly MHD_OMP_COUNTS CPUs allocated.
MHD_CPU_THREADS_PER_RANK=1
MHD_CPU_TIME=00:30:00
MHD_CPU_COUNTS=1,2,4,8
MHD_OMP_COUNTS=1,2,4,8

# Same configuration name is used by strong/weak CPU runs.  It must be a path
# relative to MHD_SOURCE_DIR or an absolute path visible from compute nodes.
MHD_CPU_CONFIG=inputs/orszag_tang_uniform.json
MHD_WEAK_STEPS=50

# GPU correctness gate is opt-in. It builds CPU and CUDA binaries in the job,
# runs CUDA CTest (except multi-rank MPI parity), and stores CPU/GPU parity logs.
MHD_GPU_ACCOUNT=''          # нужно только для --cuda-validation
MHD_GPU_PARTITION=''        # нужно только для --cuda-validation
MHD_GPU_NODES=1
MHD_GPU_GPUS=1
MHD_GPU_CPUS_PER_TASK=8
MHD_GPU_TIME=00:20:00
# RTX 4090 = 89.  Ask the K10 administrator for its actual GPU architecture.
MHD_GPU_ARCH=89

# Improved legacy case.  The structured mesh avoids a Netgen dependency during
# the first cluster smoke campaign.  Change the case/resolution only knowingly.
MHD_LEGACY_CASE=rotor
MHD_LEGACY_NX=128
MHD_LEGACY_NY=128
# CPUs for an isolated legacy build (the corrected solver run itself is serial).
MHD_LEGACY_BUILD_CPUS=8
